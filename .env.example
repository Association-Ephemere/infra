# Copier en .env et remplir pour chaque PC

# Profil Docker Compose : primary (PC A) ou secondary (PC B)
COMPOSE_PROFILES=primary

# Identifiant de ce stand (doit être unique par PC)
STAND_ID=stand-a

# IP du PC A sur le réseau local (utilisée par MinIO et le frontend)
PRIMARY_IP=192.168.x.x

# Endpoint MinIO
# primary  : minio:9000       (service Docker local)
# secondary: 192.168.x.x:9000  (IP du PC A)
STORAGE_ENDPOINT=minio:9000
